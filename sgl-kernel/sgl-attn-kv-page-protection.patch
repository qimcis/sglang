--- /dev/null
+++ b/hopper/kv_page_protection.cuh
@@ -0,0 +1,136 @@
+#pragma once
+
+#include <cuda.h>
+#include <cuda_runtime.h>
+
+#include "flash.h"
+
+namespace flash {
+
+enum KVPageProtectionStatus : int {
+    KV_PAGE_INVALID_MAPPING = 1 << 0,
+    KV_PAGE_OWNER_MISMATCH = 1 << 1,
+    KV_PAGE_POSITION_MISMATCH = 1 << 2,
+    KV_PAGE_ATTENTION_TAG_MISMATCH = 1 << 3,
+    KV_PAGE_GENERATION_MISMATCH = 1 << 4,
+    KV_PAGE_TRANSFER_TAG_MISMATCH = 1 << 5,
+};
+
+CUTLASS_DEVICE
+int validate_kv_page_table(
+        KV_page_protection_params const& params,
+        int batch,
+        int request_idx,
+        int seqlen,
+        int const* page_table,
+        int64_t page_table_batch_stride,
+        int page_table_num_rows,
+        int page_table_num_cols,
+        int page_offset,
+        int first_page) {
+    int lane_status = 0;
+    if (batch < 0 || batch >= page_table_num_rows || seqlen < 0 || params.page_size <= 0) {
+        lane_status |= KV_PAGE_INVALID_MAPPING;
+    } else {
+        int64_t const num_pages =
+            (static_cast<int64_t>(seqlen) + params.page_size - 1) / params.page_size;
+        if (first_page < 0 || first_page > num_pages || num_pages > page_table_num_cols) {
+            lane_status |= KV_PAGE_INVALID_MAPPING;
+        } else {
+            int const lane = threadIdx.x % 32;
+            for (int64_t page_position = first_page + lane; page_position < num_pages; page_position += 32) {
+                int const local_page = page_table[batch * page_table_batch_stride + page_position];
+                int64_t const page = local_page > 0
+                    ? static_cast<int64_t>(local_page) + page_offset
+                    : local_page;
+                if (page <= 0 || page >= params.num_sidecar_pages) {
+                    lane_status |= KV_PAGE_INVALID_MAPPING;
+                    continue;
+                }
+                if (params.owner_request_indices[page] != request_idx) {
+                    lane_status |= KV_PAGE_OWNER_MISMATCH;
+                }
+                if (params.owner_page_positions[page] != static_cast<int>(page_position)) {
+                    lane_status |= KV_PAGE_POSITION_MISMATCH;
+                }
+                if (params.actual_tags[page] != params.expected_tags[page]) {
+                    lane_status |= KV_PAGE_ATTENTION_TAG_MISMATCH;
+                }
+                if (params.actual_generations[page] != params.expected_generations[page]) {
+                    lane_status |= KV_PAGE_GENERATION_MISMATCH;
+                }
+                if (params.actual_transfer_tags[page] != params.expected_transfer_tags[page]) {
+                    lane_status |= KV_PAGE_TRANSFER_TAG_MISMATCH;
+                }
+            }
+        }
+    }
+    return lane_status;
+}
+
+CUTLASS_DEVICE
+bool validate_kv_pages(KV_page_protection_params const& params, int batch) {
+    if (params.request_indices == nullptr) { return true; }
+
+    int const lane = threadIdx.x % 32;
+    int64_t request_idx_64 = lane == 0 ? params.request_indices[batch] : 0;
+    request_idx_64 = __shfl_sync(0xffffffff, request_idx_64, 0);
+    if (request_idx_64 == 0) { return true; }
+    if (request_idx_64 < 0 || request_idx_64 >= params.num_request_slots) { return false; }
+    int const request_idx = static_cast<int>(request_idx_64);
+
+    int epoch = lane == 0 ? atomicAdd(params.request_epochs + request_idx, 0) : 0;
+    int validated_epoch = lane == 0 ? atomicAdd(params.validated_epochs + request_idx, 0) : 0;
+    epoch = __shfl_sync(0xffffffff, epoch, 0);
+    validated_epoch = __shfl_sync(0xffffffff, validated_epoch, 0);
+    if (validated_epoch == epoch) {
+        int cached_status = lane == 0 ? atomicAdd(params.status + request_idx, 0) : 0;
+        cached_status = __shfl_sync(0xffffffff, cached_status, 0);
+        return cached_status == 0;
+    }
+
+    int const seqlen = params.seqlens[batch];
+    int lane_status = validate_kv_page_table(
+        params,
+        batch,
+        request_idx,
+        seqlen,
+        params.page_table,
+        params.page_table_batch_stride,
+        params.page_table_num_rows,
+        params.page_table_num_cols,
+        params.page_table_page_offset,
+        0);
+    if (params.page_table_2 != nullptr) {
+        int const first_page = params.page_table_2_window_size > 0
+            ? max(0, seqlen - params.page_table_2_window_size) / params.page_size
+            : 0;
+        lane_status |= validate_kv_page_table(
+            params,
+            batch,
+            request_idx,
+            seqlen,
+            params.page_table_2,
+            params.page_table_2_batch_stride,
+            params.page_table_2_num_rows,
+            params.page_table_2_num_cols,
+            params.page_table_2_page_offset,
+            first_page);
+    }
+
+    #pragma unroll
+    for (int offset = 16; offset > 0; offset /= 2) {
+        lane_status |= __shfl_xor_sync(0xffffffff, lane_status, offset);
+    }
+    if (lane == 0) {
+        if (lane_status != 0) {
+            atomicOr(params.status + request_idx, lane_status);
+        }
+        __threadfence();
+        atomicExch(params.validated_epochs + request_idx, epoch);
+    }
+    lane_status = __shfl_sync(0xffffffff, lane_status, 0);
+    return lane_status == 0;
+}
